# ---- Network: BNB Smart Chain MAINNET only (chainId 56) ----
NEXT_PUBLIC_CHAIN_ID=56
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
BSC_MAINNET_RPC_URL=https://bsc-dataseed.bnbchain.org
# Some public endpoints (incl. bsc-dataseed) refuse eth_getLogs. Used only to look up tx hashes.
BSC_LOGS_RPC_URL=https://bsc-rpc.publicnode.com
NEXT_PUBLIC_EXPLORER_URL=https://bscscan.com

# ---- Deployment ----
DEPLOY_CHAIN_ID=56
# Verified on chain 56 (2026-11-18): "SPACE ID Agent ID" (symbol AI), ERC-721 via ERC-165.
# Re-check against the official Binance announcement before deploying.
AGENT_ID_CONTRACT_ADDRESS=0x60b9262456de011f7d15a54cdd8c48baaa8b022f
# Multisig strongly recommended. Defaults to the deployer when unset.
ADMIN_ADDRESS=
BSCSCAN_API_KEY=

# ---- Deployed SkillProof contracts on BSC mainnet (packages/contracts/deployments/56.json) ----
NEXT_PUBLIC_AGENT_ID_ADDRESS=0x60b9262456de011f7d15a54cdd8c48baaa8b022f
NEXT_PUBLIC_PROFILE_REGISTRY=0xDaf663BF05701b509067cE2341B11FFbc227C9B9
NEXT_PUBLIC_PROJECT_REGISTRY=0x2D3d33263DdC5c117ddCC0238DE6C313021a2f7F
NEXT_PUBLIC_ATTESTATION_REGISTRY=0x713B02D4539F1D9EB60123C68cbf0D9fFA83612c
NEXT_PUBLIC_CREDENTIAL_REGISTRY=0x209f0E30e1aec3470fF41a8fC67b0351f51a5433
# Block of the deployment; lower bound for event lookups.
NEXT_PUBLIC_DEPLOY_BLOCK=134334098

# ---- Off-chain metadata ----
# Public origin used inside metadata URIs, e.g. https://skillproof.example
PUBLIC_APP_URL=http://localhost:3000
# Leave empty to use the local filesystem store (.data/metadata). Set for production.
DATABASE_URL=
